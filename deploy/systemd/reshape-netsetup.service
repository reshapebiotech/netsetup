[Unit]
Description=Reshape Netsetup Service
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=RUST_LOG=info
Environment=DNS_PORT=10053
Environment=HTTP_PORT=80
Environment=APP_PORT=3000
Environment=AP_IFACE=wlan0
Environment=CAPTIVE_IP=10.42.0.1
Environment=CONNECTIVITY_PROBE_TARGET=1.1.1.1
WorkingDirectory=/opt/reshape-netsetup
ExecStartPre=/usr/local/bin/captive-portal-rules.sh up
ExecStart=/opt/reshape-netsetup/reshape-netsetup
ExecStopPost=/usr/local/bin/captive-portal-rules.sh down
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
