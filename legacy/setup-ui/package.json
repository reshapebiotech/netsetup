{
  "name": "setup-ui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun run api && vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "bun check && prettier --check . && eslint .",
    "format": "prettier --write .",
    "api": "bun api:fetch && (bun --silent api:compare || bun --silent api:copy) || true && bun api:generate",
    "api:fetch": "curl -s localhost:9000/openapi.json -o /tmp/openapi.json",
    "api:compare": "json-diff -s /tmp/openapi.json src/lib/schemas/openapi.json",
    "api:copy": "cp /tmp/openapi.json src/lib/schemas/openapi.json",
    "api:generate": "openapi-typescript ./src/lib/schemas/openapi.json -o ./src/lib/schemas/schema.d.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.0.1",
    "@sveltejs/adapter-vercel": "^5.3.1",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@tailwindcss/nesting": "^0.0.0-insiders.565cd3e",
    "@types/eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "autoprefixer": "^10.4.19",
    "daisyui": "^4.10.5",
    "eslint": "^9.5.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.40.0",
    "json-diff": "^1.0.6",
    "openapi-fetch": "^0.11.0",
    "openapi-typescript": "^7.0.0",
    "phosphor-svelte": "^2.0.1",
    "postcss": "^8.4.38",
    "prettier": "^3.1.1",
    "prettier-plugin-svelte": "^3.1.2",
    "svelte": "^4.2.7",
    "svelte-check": "^3.6.0",
    "svelte-forms": "^2.3.1",
    "svelte-highlight": "^7.6.1",
    "tailwindcss": "^3.4.3",
    "tailwindest": "^2.3.0",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "vite": "^5.2.2"
  },
  "type": "module",
  "dependencies": {}
}
